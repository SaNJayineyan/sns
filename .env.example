# STRUCTS N SPACES — ENVIRONMENT VARIABLES CONFIGURATION (EXAMPLE)
# Copy this file to .env.local to configure production endpoints.

# Base Public Site URL (used for canonical URLs and SEO sharing)
VITE_SITE_URL=https://structsnspaces.com

# Production CRM / Consultation Form Webhook Endpoint
# Example: https://api.yourcrm.com/v1/leads or serverless function URL
VITE_CONSULTATION_API_ENDPOINT=

# Optional API Authorization Key for backend communication (never commit real secrets)
VITE_CONSULTATION_API_KEY=

# Optional Google Analytics 4 Measurement ID
VITE_GA_MEASUREMENT_ID=
